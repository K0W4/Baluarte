          }
        }
      }
    },
    "Vamos conferir os dados com o registro da Ordem e avisar assim que o Capítulo entrar na lista. Enquanto isso, você pode continuar usando o app normalmente.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We will check the details against the Order's registry and let you know as soon as the Chapter is listed. In the meantime you can keep using the app normally."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificaremos los datos con el registro de la Orden y te avisaremos en cuanto el Capítulo entre en la lista. Mientras tanto, puedes seguir usando la app normalmente."
          }
        }
      }
    },
