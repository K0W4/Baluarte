    },
    "Gere um código e mande no grupo do Capítulo. Quem abrir entra direto, sem passar pela fila de aprovação.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generate a code and drop it in the Chapter's group. Whoever opens it joins straight away, with no approval queue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Genera un código y compártelo en el grupo del Capítulo. Quien lo abra ingresa directo, sin pasar por la cola de aprobación."
          }
        }
      }
    },
