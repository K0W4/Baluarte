    "A propriedade só pode ser transferida para alguém ativo e com conta no app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ownership can only be transferred to someone active who has an account in the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La propiedad solo puede transferirse a alguien activo y con cuenta en la app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A propriedade só pode ser transferida para alguém ativo e com conta no app."
          }
        }
      }
    },
