          "stringUnit": {
            "state": "translated",
            "value": "Este Capítulo já tem um Fundador. Quem quiser entrar deve solicitar a ele."
          }
        }
      }
    },
    "Este cadastro ainda não pertence a ninguém, então não tem acesso para ajustar.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This entry does not belong to anyone yet, so there is no access to adjust."
