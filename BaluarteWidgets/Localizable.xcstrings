    "Este Capítulo já tem um Fundador. Quem quiser entrar deve solicitar a ele.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Chapter already has a Founder. Anyone who wants to join should ask them."
          }
        },
