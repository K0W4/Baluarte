    },
    "%@ poderá editar o quadro, criar eventos, metas e comissões, e aprovar quem pede para entrar." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ will be able to edit the roster, create events, goals and committees, and approve people asking to join."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ podrá editar el cuadro, crear eventos, metas y comités, y aprobar a quienes piden entrar."
