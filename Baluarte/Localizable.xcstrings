    "%@ deixa de administrar o Capítulo e passa a ver o app como qualquer membro." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ stops administering the Chapter and sees the app as any member does."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ deja de administrar el Capítulo y ve la app como cualquier miembro."
          }
        }
      }
    },
    "%@ deixa de aprovar fundações de Capítulo. O acesso ao próprio Capítulo não muda." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ stops approving Chapter foundings. Their access to their own Chapter does not change."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ deja de aprobar fundaciones de Capítulo. Su acceso al propio Capítulo no cambia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ deixa de aprovar fundações de Capítulo. O acesso ao próprio Capítulo não muda."
          }
        }
      }
    },
    "%@ deixou de administrar a plataforma" : {
      "localizations" : {
