            "value" : "Quién lo solicita"
          }
        }
      }
    },
    "Quem já está no Capítulo pode gerar um código para você. Com ele, você entra direto." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
