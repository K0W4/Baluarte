    "%@ passa a ser o Fundador do Capítulo e você vira administrador. Só o novo Fundador poderá devolver a posse." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ becomes Founder of the Chapter and you become an administrator. Only the new Founder can hand ownership back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pasa a ser el Fundador del Capítulo y tú te conviertes en administrador. Solo el nuevo Fundador podrá devolver la propiedad."
          }
        }
      }
    },
    "%@ passou a administrar a plataforma" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ became a platform administrator"
